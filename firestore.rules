rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function incoming() {
      return request.resource.data;
    }

    function isValidEmployee(data) {
      return data.id is string && 
             data.nik is string && 
             data.nip is string && 
             data.nama is string && 
             data.jenjangPendidikan is string && 
             data.divisi is string && 
             data.jenisKelamin is string && 
             data.alamat is string && 
             data.noHp is string && 
             data.foto is string && 
             data.ttdElektronik is string && 
             data.createdAt is string;
    }

    function isValidSettings(data) {
      return data.namaInstansi is string && 
             data.alamat is string && 
             data.noTelp is string;
    }

    function isValidIdentity(data) {
      return data.kepalaStasiunNama is string && 
             data.kepalaStasiunTtd is string && 
             data.kepalaBidangNama is string && 
             data.kepalaBidangTtd is string && 
             data.ketuaTimSiaranNama is string && 
             data.ketuaTimSiaranTtd is string && 
             data.ketuaTimPemberitaanNama is string && 
             data.ketuaTimPemberitaanTtd is string && 
             data.ketuaTimTeknikNama is string && 
             data.ketuaTimTeknikTtd is string && 
             data.ketuaTimKontenNama is string && 
             data.ketuaTimKontenTtd is string && 
             data.ketuaTimLayananNama is string && 
             data.ketuaTimLayananTtd is string;
    }

    function isValidNotification(data) {
      return data.id is string && 
             data.title is string && 
             data.message is string && 
             data.type is string && 
             data.timestamp is string && 
             data.isRead is bool;
    }

    function isValidAgreement(data) {
      return data.id is string && 
             data.year is number && 
             data.level is string && 
             data.assignedToName is string && 
             data.status is string && 
             data.createdAt is string;
    }

    function isValidContract(data) {
      return data.id is string && 
             data.partnerName is string && 
             data.contractNo is string && 
             data.activityName is string && 
             data.cooperationType is string && 
             data.value is number && 
             data.realizedPnbp is number && 
             data.paymentStatus is string && 
             data.startDate is string && 
             data.endDate is string && 
             data.linkedIndicatorId is string;
    }

    function isValidTarget(data) {
      return data.id is string && 
             data.employeeId is string && 
             data.dailyTarget is number && 
             data.monthlyTarget is number && 
             data.linkedIndicatorId is string && 
             data.year is number;
    }

    function isValidReport(data) {
      return data.id is string && 
             data.employeeId is string && 
             data.title is string && 
             data.url is string && 
             data.type is string && 
             data.date is string;
    }

    // Collection match rules
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if isValidEmployee(incoming());
    }

    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidSettings(incoming());
    }

    match /identity/{identityId} {
      allow read: if true;
      allow write: if isValidIdentity(incoming());
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidNotification(incoming());
    }

    match /agreements/{agreementId} {
      allow read: if true;
      allow write: if isValidAgreement(incoming());
    }

    match /contracts/{contractId} {
      allow read: if true;
      allow write: if isValidContract(incoming());
    }

    match /reporterTargets/{targetId} {
      allow read: if true;
      allow write: if isValidTarget(incoming());
    }

    match /newsReports/{reportId} {
      allow read: if true;
      allow write: if isValidReport(incoming());
    }
  }
}
